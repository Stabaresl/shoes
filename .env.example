# Copien este archivo como .env.local (en su computador) o pongan estas variables
# en Vercel → Settings → Environment Variables.

# Enlace de la hoja de Google con el catálogo (compartida como "cualquiera con el
# enlace puede ver"). Sin esta variable la tienda usa src/lib/products.ts.
CATALOGO_URL=

# Opcional: clave de Google (API de Drive) para poder poner CARPETAS de Drive en
# la columna "fotos". Para enlaces a fotos sueltas no hace falta.
GOOGLE_API_KEY=

# Clave para refrescar el catálogo al instante: /api/revalidar?clave=ESTA_CLAVE
REVALIDAR_CLAVE=

# Opcional: otro WhatsApp para la tienda (por defecto 573122651224, ver src/lib/tienda.ts).
NEXT_PUBLIC_WHATSAPP=

# URL pública de la tienda (la usan las automatizaciones de n8n).
SITIO_URL=
